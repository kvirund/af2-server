# Внутри репозитория каждый текстовый файл лежит с LF; здесь сказано, что
# получает рабочая копия, чтобы это не решал редактор. Кодировку git не
# закрепляет: всё у нас в UTF-8 без BOM, и это проверяет сам сервер при чтении
# (src/files.rs).
* text=auto

# Эти файлы правят руками на Windows, в том числе игроки, а блокнот до
# Windows 11 показывает файл с одними LF одной длинной строкой.
config/*.json text eol=crlf
*.ps1 text eol=crlf
