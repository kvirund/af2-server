<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PhotonProbe</AssemblyName>
    <RootNamespace>PhotonProbe</RootNamespace>
    <!-- Photon3Unity3D.dll is a Unity-profile assembly; silence the framework warning. -->
    <NoWarn>$(NoWarn);MSB3270;CS1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Photon3Unity3D">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\common\AF2\AFCGame_Data\Managed\Photon3Unity3D.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
