      // Водоросли зелёные, красные, синие
      { "item": 1148, "weight": 30 },
      { "item": 1149, "weight": 20 },
      { "item": 1150, "weight": 12 },
      // Мутомасса, биомасса, биогель, биосоль
      { "item": 1258, "weight": 4 },
      { "item": 1167, "weight": 6 },
      { "item": 1200, "weight": 4 },
      { "item": 1201, "weight": 6 },
