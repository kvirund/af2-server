// Настройки сервера. Изменения применяются после перезапуска сервера.
// Рыба и водоёмы лежат отдельно, в config/fish.json.
{
  "server": {
    "bind": "0.0.0.0",
    "port": 9201
  },

  "character": {
    "name": "Рыбак",
    "level": 1,
    // Действуют только для нового персонажа. Прогресс хранится в data/af2.sqlite.
    "startingMoney": 1000,
    "premiumMoney": 0,
    "startBase": 1
  },

  "fishing": {
    // Виды-мутанты: блоки с isMutant=1 в файле клиента fishModelData (resources.assets).
    // Кислотник, топорец, винт, шипастый ёрш, чёрный рак, илистый дракон, торпеда, чёрный окунь,
    // миньон-ктулху, кардан, гигантский усач, алтуфа, сом чернобыльский, ледяные лещ и вьюн.
    // Нужны рецептам «только мутант» (мутофарш); в рецепты «любая рыба» мутанты не идут.
    "mutantSpecies": [2, 12, 17, 18, 122, 131, 134, 135, 141, 146, 216, 339, 414, 502, 503],
    // Шанс поклёвки за один запрос клиента (раз в 5 секунд).
    "biteChance": 0.35,
    // Поведение рыбы после поклёвки: состояние:следующее+вес, записи через /.
    // 1 подёргивает поплавок, 2 приподнимает его, 3 и 5 берёт наживку, 6 топит поплавок.
    // Подсечка срабатывает с шансом 5% в состоянии 1, 80% в 2, 90% в 3 и 5, 100% в 6.
    // Настоящие значения хранились на сервере, эти подобраны.
    "biteBehaviour": "0:1+100/1:1+45,2+55/2:3+35,5+30,6+35/3:5+50,6+50/5:6+70,1+30/6:6+75,0+25",
    // Доля поклёвок мелочи, слишком мелкой для наживки: поплавок нырнёт один раз,
    // подсечь такую рыбу нельзя. Остальные поклёвки подходят наживке по весу.
    "smallFishNibbleShare": 0.25,
    // Сколько штук наживки уходит на каждую вытащенную рыбу. Блёсны и другие
    // предметы без стопки не тратятся
    "baitPerCatch": 1,
    // Суммарный вес видов в точке, при котором шанс достигает biteChance.
    "fullBiteWeight": 8,

    // Какая доля улова крупная и трофейная, остальное маленькая.
    "largeShare": 0.30,
    "trophyShare": 0.08,
    // Глубже этого трофеи клюют в deepTrophyMultiplier раз чаще.
    "trophyDepthCm": 300,
    "deepTrophyMultiplier": 2,
    // Самая тяжёлая рыба относительно трофейного порога.
    "topWeightFactor": 1.5,

    // Донная рыба: насколько близко ко дну нужно быть, и множители шанса.
    "nearBottomCm": 40,
    "nearBottomBonus": 2.5,
    "awayFromBottomFactor": 0.35,
    // Рыба, любящая глубину: множители при глубине точки от trophyDepthCm и меньше.
    "deepWaterBonus": 2,
    "shallowWaterFactor": 0.5,

    // Игровых часов за реальный. Ночь считается с 21:30 до 4:30.
    "gameHoursPerRealHour": 12,

    // Вываживание: скорость и выносливость растут с весом в заданных пределах.
    "gramsPerSpeed": 500,
    "minSpeed": 1,
    "maxSpeed": 4,
    "gramsPerStamina": 40,
    "minStamina": 8,
    "maxStamina": 60,
    "hardyStaminaFactor": 1.4
  },

  // Опыт и уровни. Формулы придуманы: на клиенте их нет.
  // Только множитель личного рекорда взят из текста клиента («опыт x3»).
  "progression": {
    "maxLevel": 40,
    // Опыта до следующего уровня: levelBase * уровень ^ levelExponent
    "levelBase": 200,
    "levelExponent": 1.3,
    // Опыт за рыбу в садке: (за штуку + за кг * вес) * множитель размера
    "experiencePerFish": 2,
    "experiencePerKg": 3,
    "largeExperienceFactor": 1.5,
    "trophyExperienceFactor": 3,
    "recordExperienceFactor": 3,
    // Показатели на 1 уровне и прибавка за каждый следующий:
    // жизнь, выносливость, радстойкость, еда, вода (клиенту уходят в его порядке: радстойкость раньше выносливости)
    "baseVital": 100,
    "vitalsPerLevel": [5, 2, 1, 1, 1]
  },

  // Цены скупщика придуманы. Цена за кг: basePricePerKg * редкость * размер,
  // редкость = sqrt(наибольший share / share вида из fish.json), от 1 у самой частой рыбы.
  "fishMarket": {
    "basePricePerKg": 100,
    "largePriceFactor": 1.5,
    "trophyPriceFactor": 3,
    // Кто скупает рыбу: база -> номера NPC (addId в сцене клиента). В Убежище это Гоги (5),
    // на остальных базах «Рыбный торговец» (1). Другие NPC, например био-генератор (NPC 2 в Убежище),
    // рыбу не покупают
    "buyers": { "1": [5], "3": [1], "4": [1], "5": [1], "6": [1], "7": [1], "8": [1], "9": [1] }
  },

  // Вкладки сумок, склад и покупка ячеек. Цены придуманы.
  "bags": {
    // Сколько вкладок показать: 1 Снасти, 2 Оснастка, ... 10 Разное. Не больше 14
    "pages": 10,
    // Ячеек в каждой вкладке и на складе с самого начала
    "startCells": 10,
    "storageCells": 45,
    // Сколько ячеек даёт одна покупка
    "cellsPerPurchase": 5,
    // Цена первой покупки; вторая в сумке стоит вдвое больше, третья втрое и так далее
    "purchaseMoney": 500,
    "purchasePremium": 10,
    // Куда попадают вещи: страница -> виды предметов (wtype, как во вкладках магазина).
    // Разложено по названиям вкладок, настоящая таблица была на закрытом сервере.
    // 1 Снасти, 2 Оснастка, 3 Оборудование, 4 Медицина, 5 Ремесло, 6 Одежда, 7 Наживки
    "pageKinds": {
      "1": [1, 2, 3, 4],
      "2": [5, 6, 7, 8, 9, 13],
      "3": [14, 15, 16, 36],
      "4": [21, 22, 23],
      "5": [24, 25, 26, 28],
      "6": [17, 18, 19, 20, 29, 33],
      "7": [0, 10, 11, 12, 37, 38, 39, 40]
    },
    // Всё остальное: 10 Разное. В заполненную вкладку вещь не купить: сначала «+»
    "otherPage": 10,
    // Что даёт навыки и параметры. Одежда и снаряжение складываются,
    // из собранных снастей по каждому навыку считается лучший набор (придумано)
    "wornBags": [60],
    "tackleBags": [100, 101, 102]
  },

  // Шкалы. Из гайдов: без еды вода уходит втрое быстрее, без воды жизнь -0,2 в секунду,
  // при еде ниже 30 усталость не проходит, очки работы +10 в минуту, радиация по базам.
  // Всё остальное придумано: скорости еды, воды и усталости в гайдах не записаны.
  "vitals": {
    "tickSeconds": 5,
    "saveEverySeconds": 30,
    "foodPerMinute": 0.5,
    "waterPerMinute": 0.8,
    "noFoodWaterFactor": 3,
    "noWaterLifePerSecond": 0.2,
    "noResistanceLifePerSecond": 0.1,
    // Усталость проходит, если столько секунд поплавок не в воде и рыба не вытащена
    "restAfterSeconds": 30,
    "restStaminaPerMinute": 6,
    "restNeedsFood": 30,
    "staminaPerFish": 1,
    "staminaPerKg": 0.5,
    // Радстойкость в минуту на каждую единицу радиации
    "radiationPerMinutePerPoint": 0.02,
    // Смерти пока нет: жизнь не падает ниже этого
    "lowestLife": 1,
    "workPointsPerMinute": 10,
    "maxWorkPoints": 3000,
    // База -> радиация днём и ночью. В самой базе (не на локации) радиации нет.
    // 2 Плато и 5 Изумрудное в гайдах не указаны, значения придуманы
    "radiation": {
      "1": [5, 35],
      "2": [5, 35],
      "3": [30, 110],
      "4": [5, 35],
      "5": [5, 35],
      "6": [10, 65],
      "7": [5, 220],
      "8": [0, 120],
      "9": [20, 40]
    }
  },

  // Действие параметров, проценты за очко. Образование из гайдов,
  // Удача тоже, но к чему она относится, там не сказано: шанс трофея придуман
  "loot": {
    // Что ловится вместе с рыбой. Список из гайда Элиаса (steamcommunity.com/sharedfiles/filedetails/?id=1102257736,
    // «Лут который можно выловить вместе с рыбой»): водоросли трёх цветов, Струна-3, Мононить-8,
    // Бамбук-2, Бамбук-8, РодРолл-2, -6, -8, рецепт «Кусочки моллюска», карточка «Холод», жетон
    // исследователя, тройник-15-2, металлический поводок, Баланс-B1 ночной, Баланс-B3, экстракты
    // опыта 100, 400, 1500, 6000, мутомасса, биомасса, детали и ресурсы для крафта.
    // Шансы и веса в гайдах не записаны: придуманы (снасти, жетоны и экстракты реже прочего).
    // Шанс в процентах на каждую вытащенную рыбу
    "chancePercent": 6,
    // item: номер предмета, weight: относительный вес, count: сколько штук (по умолчанию 1)
    "items": [
      // Водоросли зелёные, красные, синие
      { "item": 1148, "weight": 30 },
      { "item": 1149, "weight": 20 },
      { "item": 1150, "weight": 12 },
      // Мутомасса, биомасса, биогель, биосоль
      { "item": 1258, "weight": 4 },
      { "item": 1167, "weight": 6 },
      { "item": 1200, "weight": 4 },
      { "item": 1201, "weight": 6 },
      // Ресурсы: закрепитель, морёное дерево, болотный мох, растворитель, гирокат, гео, крио,
      // темпо, старая катушка, кристаллит, кирст, сгусток ила, тина, обломок удилища, чёрная желчь
      { "item": 1185, "weight": 8 },
      { "item": 1184, "weight": 8 },
      { "item": 1209, "weight": 8 },
      { "item": 1188, "weight": 4 },
      { "item": 1206, "weight": 3 },
      { "item": 1208, "weight": 3 },
      { "item": 1186, "weight": 3 },
      { "item": 1210, "weight": 3 },
      { "item": 1211, "weight": 3 },
      { "item": 1189, "weight": 3 },
      { "item": 1183, "weight": 3 },
      { "item": 1207, "weight": 3 },
      { "item": 1187, "weight": 3 },
      { "item": 1190, "weight": 3 },
      { "item": 1191, "weight": 3 },
      // Детали: лак, клей, шток, кноб, бесконечник, зелёный железит, зелёная смола, стружка,
      // ролики, втулка, заготовка катушки, заготовка удилища
      { "item": 1157, "weight": 4 },
      { "item": 1159, "weight": 4 },
      { "item": 1216, "weight": 3 },
      { "item": 1215, "weight": 3 },
      { "item": 1212, "weight": 3 },
      { "item": 1135, "weight": 3 },
      { "item": 1127, "weight": 3 },
      { "item": 1158, "weight": 3 },
      { "item": 1214, "weight": 3 },
      { "item": 1213, "weight": 3 },
      { "item": 1217, "weight": 3 },
      { "item": 1182, "weight": 3 },
      // Снасти: Струна-3, Мононить-8, Бамбук-2, Бамбук-8, РодРолл-2, -6, -8, тройник-15-2,
      // мет. поводок, Баланс-B1 ночной, Баланс-B3
      { "item": 1014, "weight": 2 },
      { "item": 1225, "weight": 1 },
      { "item": 1002, "weight": 2 },
      { "item": 1063, "weight": 1 },
      { "item": 1221, "weight": 2 },
      { "item": 1015, "weight": 1 },
      { "item": 1028, "weight": 1 },
      { "item": 1286, "weight": 2 },
      { "item": 1289, "weight": 2 },
      { "item": 1181, "weight": 1 },
      { "item": 1300, "weight": 1 },
      // Рецепт «Кусочки моллюска», карточка «Холод», жетон исследователя
      { "item": 1177, "weight": 1 },
      { "item": 1266, "weight": 1 },
      { "item": 1180, "weight": 1 },
      // Экстракты опыта 100, 400, 1500, 6000
      { "item": 1425, "weight": 2 },
      { "item": 1426, "weight": 1 },
      { "item": 1427, "weight": 1 },
      { "item": 1428, "weight": 1 },
      // Карточка «Рыбалка»: была в списке раньше, в гайде её нет
      { "item": 1330, "weight": 2 }
    ],
    // Карточка базы, на которой ловишь: отдельный шанс (по гайду его поднимает репутация базы)
    "baseCardChancePercent": 1,
    "baseCards": { "1": 1310, "3": 1312, "4": 1313, "5": 1313, "6": 1311, "7": 1437, "8": 1522 },
    // Премиум-валюта с рыбой: шанс в процентах на каждую вытащенную рыбу и сколько (от и до).
    // В оригинале её покупали за деньги; здесь она ловится, числа придуманы.
    // Для сравнения: ячейка сумки 10, курс 20, Уклеечный-I 50
    // Сейчас в среднем 1 единица на 200 рыб
    "premiumChancePercent": 0.5,
    "premium": [1, 1]
  },

  "attributes": {
    "educationExperiencePercent": 1.33,
    "educationLevelCostPercent": 0.1,
    "luckTrophyPercent": 1.33
  },

  "shop": {
    // true: каждая база продаёт только то, что перечислено в config/shops.json
    // (списки из гайда игроков). false: продаётся всё, у чего в клиенте есть цена
    "guideStock": true,
    // true: предмет нельзя купить раньше его уровня (minimalLevel из описания предмета).
    // false: продаётся всё и сразу
    "enforceLevels": true,
    // Виды вещей, для которых в клиенте нет ячейки надевания:
    // 19 штаны и 20 сапоги (ячейки отключены в самом клиенте), 29 тестовый костюм робота
    "hiddenKinds": [19, 20, 29],
    // Отдельные предметы, которых нет в продаже
    "hiddenItems": [],
    // Цены вместо цен из клиента: предмет -> цена
    "prices": {
      // Придумано: курсы навыков в клиенте стоят только премиум-валюту, а по гайду
      // первые три дают задания в Убежище, которых здесь нет
      "1274": 5000,  // Курс "Снасти А"
      "1275": 5000,  // Курс "Атлетика"
      "1276": 5000,  // Курс "Ремесло"
      "1277": 50000, // Курс "Снасти Б"
      "1373": 20000  // Курс "Грибник"
    }
  },

  // Навыки. По гайдам: в навык на изучении идёт 10% всего опыта, повторный курс даёт
  // +300 очков навыку на изучении (+100 поднавыку, если навык уже на максимуме),
  // максимум 5 уровней. Цена уровня берётся из дерева навыков клиента (data/skills.json).
  // Придумано: лимит уровней всех навыков вместе = limitBase + limitPerLevel * уровень.
  "skills": {
    "experiencePercent": 10,
    "courseExperience": 300,
    "courseSubExperience": 100,
    "maxLevel": 5,
    "limitBase": 2,
    "limitPerLevel": 1
  },

  "travel": {
    // true: клиент не пустит на базу ниже её minLevel.
    // false: все базы открыты с самого начала
    "enforceLevels": true
  },

  // minLevel взят из гайдов игроков, для баз 5 и 9 придуман.
  // travelCost: цена перехода через карту, в оригинале неизвестна.
  // locations: номера из maps.txt, 0 это сама база.
  "bases": {
    "1": { "name": "Убежище", "minLevel": 1, "travelCost": 0, "locations": [0, 1, 2, 3, 4, 5, 6] },
    "2": { "name": "Плато великанов", "minLevel": 1, "travelCost": 0, "locations": [0, 21, 22, 23] },
    "3": { "name": "Пустошь", "minLevel": 8, "travelCost": 0, "locations": [0, 31, 32, 33, 34] },
    "4": { "name": "Озеро Кулгу", "minLevel": 15, "travelCost": 0, "locations": [0, 41, 42, 43, 44, 45, 46, 47] },
    "5": { "name": "Озеро Изумрудное", "minLevel": 20, "travelCost": 0, "locations": [0, 51, 52, 53, 54] },
    "6": { "name": "Карасиный пруд", "minLevel": 5, "travelCost": 0, "locations": [0, 61, 62, 63, 64, 65, 66] },
    "7": { "name": "Разливы", "minLevel": 15, "travelCost": 0, "locations": [0, 71, 72, 73, 74, 75, 76, 77, 78, 79] },
    "8": { "name": "Дельта", "minLevel": 30, "travelCost": 0, "locations": [0, 81, 82, 83, 84, 85, 86, 87, 88] },
    "9": { "name": "Река Пра", "minLevel": 25, "travelCost": 0, "locations": [0, 91, 92, 93, 94] }
  },

  // Стартовые вещи нового сохранения. item: номер предмета в клиенте.
  // Сумки: 100 поплавочная (1 удилище, 2 катушка, 3 леска, 4 поплавок, 10 крючок, 20 наживка),
  // 60 одежда (6 садок), 0 инвентарь (ячейка = ряд * 9 + столбец).
  // Самое дешёвое из продающегося; из двух поплавков по одной цене выбран с сигналом.
  "starterKit": [
    { "item": 1001, "bag": 100, "cell": 1, "count": 1 },
    { "item": 1068, "bag": 100, "cell": 2, "count": 1 },
    { "item": 1004, "bag": 100, "cell": 3, "count": 1 },
    { "item": 1160, "bag": 100, "cell": 4, "count": 1 },
    { "item": 1005, "bag": 100, "cell": 10, "count": 1 },
    { "item": 1018, "bag": 100, "cell": 20, "count": 100 },
    { "item": 1024, "bag": 60, "cell": 6, "count": 1 }
  ]
}
