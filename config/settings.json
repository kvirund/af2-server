      { "item": 1190, "weight": 3 },
      { "item": 1191, "weight": 3 },
      // Детали: лак, клей, шток, кноб, бесконечник, зелёный железит, зелёная смола, стружка,
      // ролики, втулка, заготовка катушки, заготовка удилища
      { "item": 1157, "weight": 4 },
      { "item": 1159, "weight": 4 },
      { "item": 1216, "weight": 3 },
      { "item": 1215, "weight": 3 },
      { "item": 1212, "weight": 3 },
      { "item": 1135, "weight": 3 },
      { "item": 1127, "weight": 3 },
      { "item": 1158, "weight": 3 },
      { "item": 1214, "weight": 3 },
      { "item": 1213, "weight": 3 },
      { "item": 1217, "weight": 3 },
      { "item": 1182, "weight": 3 },
      // Снасти: Струна-3, Мононить-8, Бамбук-2, Бамбук-8, РодРолл-2, -6, -8, тройник-15-2,
      // мет. поводок, Баланс-B1 ночной, Баланс-B3
      { "item": 1014, "weight": 2 },
      { "item": 1225, "weight": 1 },
      { "item": 1002, "weight": 2 },
      { "item": 1063, "weight": 1 },
      { "item": 1221, "weight": 2 },
      { "item": 1015, "weight": 1 },
      { "item": 1028, "weight": 1 },
      { "item": 1286, "weight": 2 },
      { "item": 1289, "weight": 2 },
      { "item": 1181, "weight": 1 },
      { "item": 1300, "weight": 1 },
      // Рецепт «Кусочки моллюска», карточка «Холод», жетон исследователя
      { "item": 1177, "weight": 1 },
      { "item": 1266, "weight": 1 },
      { "item": 1180, "weight": 1 },
      // Экстракты опыта 100, 400, 1500, 6000
