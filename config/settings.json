  "attributes": {
    "educationExperiencePercent": 1.33,
    "educationLevelCostPercent": 0.1,
    "luckTrophyPercent": 1.33
  },

  "shop": {
    // true: каждая база продаёт только то, что перечислено в config/shops.json
    // (списки из гайда игроков). false: продаётся всё, у чего в клиенте есть цена
    "guideStock": true,
    // true: предмет нельзя купить раньше его уровня (minimalLevel из описания предмета).
    // false: продаётся всё и сразу
    "enforceLevels": true,
    // Виды вещей, для которых в клиенте нет ячейки надевания:
    // 19 штаны и 20 сапоги (ячейки отключены в самом клиенте), 29 тестовый костюм робота
    "hiddenKinds": [19, 20, 29],
    // Отдельные предметы, которых нет в продаже
    "hiddenItems": [],
    // Цены вместо цен из клиента: предмет -> цена
    "prices": {
      // Придумано: курсы навыков в клиенте стоят только премиум-валюту, а по гайду
      // первые три дают задания в Убежище, которых здесь нет
      "1274": 5000,  // Курс "Снасти А"
      "1275": 5000,  // Курс "Атлетика"
      "1276": 5000,  // Курс "Ремесло"
      "1277": 50000, // Курс "Снасти Б"
      "1373": 20000, // Курс "Грибник"
      // Вещи из игровых пакетов: в клиенте у них кроме цены в кредитах есть цена в
      // премиум-валюте, поэтому без этих строк они не продаются. Цены в кредитах взяты
      // из клиента (priceCr); у Матч-Премиума её нет, 64000 придумано по удилищу
      // 1338 (20 кг). 50 эргов из «Быстрого старта» не продаются.
      "1304": 9306,  // Юниор
      "1305": 3000,  // ЮниорРолл
      "1306": 5000,  // ЮниорЛайн
      "1301": 10,    // Баланс-B4 (увеличенный)
      "1494": 3000,  // Волгаръ-Ролл
      "1493": 5000,  // Волгаръ-Лайн
      "1495": 850,   // Метод-Волгаръ
      "1376": 64000, // Матч-Премиум
      "1384": 3000,  // Матч Ролл Премиум
      "1385": 5000,  // Матч-Лайн
      "1409": 10     // Матчевый
    }
  },

  // Навыки. По гайдам: в навык на изучении идёт 10% всего опыта, повторный курс даёт
  // +300 очков навыку на изучении (+100 поднавыку, если навык уже на максимуме),
  // максимум 5 уровней. Цена уровня берётся из дерева навыков клиента (data/skills.json).
  // Придумано: лимит уровней всех навыков вместе = limitBase + limitPerLevel * уровень.
  "skills": {
    "experiencePercent": 10,
    "courseExperience": 300,
    "courseSubExperience": 100,
    "maxLevel": 5,
    "limitBase": 2,
    "limitPerLevel": 1,
    // Приманки по subType описания предмета (из клиента): 6 твистеры и джиговые WCK -> Джиги (410),
    // 7 воблеры VOB и TopW -> Воблеры (415), 4 вертушки VIB и 5 колебалки CRL -> Блёсны (425).
    // Придумано: каждое очко навыка (val из дерева, 1 за уровень) прибавляет 5% к шансу поклёвки на такую приманку.
    "lureSkills": { "4": 425, "5": 425, "6": 410, "7": 415 },
    "lureBitePercent": 5,
    // Разделочный стол — станок 3 (его рецепты берут рыбу). Придумано: «Полевая переработка рыбы»
    // прибавляет свои очки к шансу крита на нём, крит даёт больше ресурсов.
    "fishCuttingStation": 3
  },

  // Доктор Григорий в Убежище (диалог quests/6.lng, NPC 6 в сцене базы).
  // Из диалога: лечит раз в час за рыбу тяжелее 800 г, только до 15 уровня, +50 здоровья
  // и +50 радстойкости. Из гайда Элиаса: у доктора при лечении можно поесть и попить.
  // Из гайда 810493656: при лечении выдаёт по одной слабой аптечке (1111) и слабому антирадану (1119).
  // Придумано: сколько еды и воды он даёт.
  "doctor": {
    "npc": 6,
    "base": 1,
    "maxLevel": 15,
    "minFishGrams": 800,
    "cooldownMinutes": 60,
    "life": 50,
    "radiation": 50,
    "food": 50,
    "water": 50,
    "gifts": [1111, 1119],
    // Из диалога доктора (quests/6.lng): за 5 биомассы (1167) он пускает в холодильник
    // и даёт карточку "Холод", потом по карточке за каждые 5 мутомассы (1258).
    // Придумано: что мутомассу можно носить ему сколько угодно раз.
    "fridgeUnlock": { "item": 1167, "count": 5 },
